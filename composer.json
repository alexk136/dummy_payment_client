{
    "name": "dummy-demo/client",
    "description": "Dummy Demo API Client",
    "type": "symfony-bundle",
    "license": "unlicense",
    "version": "1.0.0",
    "keywords": [
        "openapi",
        "php",
        "sdk",
        "rest",
        "api"
    ],
    "require": {
        "php": "^8.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0",
        "symfony/framework-bundle": "^5.4 || ^6.0 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5",
        "symfony/debug-bundle": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "DummyDemo\\": "src/",
            "DummyDemo\\ClientBundle\\": "src/ClientBundle/"
        }
    },
    "autoload-dev": {
        "psr-4": { "DummyDemo\\\tests\\" : "tests/" }
    }
}
